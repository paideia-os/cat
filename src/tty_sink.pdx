// src/tty_sink.pdx — cat.M1-003 (skeleton) → cat.M2-001..M2-004
//                    → v1.1-A retirement → v1.2.0-A (Closes #24)
// TtySink module: bounded write sink standing in for KIND_TTY(write).
//
// v1.2.0-A retirement note (Closes cat #24 — 64 KiB output ceiling)
// -----------------------------------------------------------------
// The 64 KiB output ceiling that cat #24 flagged is REMOVED in the
// live path by the v1.1-A substrate flip (see src/entry.pdx header
// note "Retired stub modules (unreachable dead code post-v1.1-A)").
// _start no longer routes through cat_dispatch, so no runtime path
// reaches tty_write_bytes / tty_write_byte / tty_reset / tty_out_buf
// / tty_out_len — the live byte pump in _start reads sys_read(fd,
// cat_buf, 4096) in a loop until rax == 0 (EOF) and hands each
// n-byte chunk directly to sys_write(1, cat_buf, n) with no
// intermediate buffer and no cap. A 1 GiB file cats through cat_buf
// in 262144 sys_read/sys_write pairs — no OOM, no ceiling, no
// buffered-write overflow to distinguish from EOF.
//
// The stub's own 64 KiB TTY_OUT_CAP + tty_out_buf sizing below is
// UNCHANGED because six tests/*.pdx fixtures still assert against
// the TTY_SINK_OVERFLOW return code at the pre-substrate-flip cap
// (M2 correctness matrix — the fixtures compile but are never
// linked into cat.elf, so the constants have no effect on the
// shipped binary). Removing this file wholesale is a downstream
// cleanup requiring coordinated updates to caps.decl / STATUS.md /
// manifest.pdxsig / cat.pdxdoc / tests/README.md — tracked as a
// v1.1-B follow-up alongside the sibling dead-module removals.
//
// Design context (v1.0 posture, retained for historical reference)
// ----------------------------------------------------------------
// M1's sink was a 4 KiB `.bss` scratch buffer with a cursor. M2
// widens the cap to 64 KiB (65536) so the M2 render + streaming
// paths — which drive the sink chunk-by-chunk from the 64 KiB
// FileRead::chunk_buf plus per-byte from Render::render_write_bytes
// (line-numbering prefix + -A escapes may inflate output beyond the
// input byte count) — can be exercised end-to-end from an M4 test
// harness without exhausting the sink on the first chunk. M2 also
// adds `tty_write_byte(byte)` — a leaf single-byte-write helper the
// Render module calls per emitted output byte (line-num digits,
// `^X` escapes, `$` end-of-line markers).
//
// The real KIND_TTY(write) at shell.M4 has no cap; the sink cap
// exists only for the pre-shell.M4 test harness. Field names
// (`tty_out_buf`, `tty_out_len`) do not change between M1 and M2 —
// the shell.M4 patch is still a leaf-function body edit inside
// `tty_write_bytes` + `tty_write_byte`.
//
// Contract
// --------
//   tty_reset : () -> () !{mem} @{}
//     Zero tty_out_len. Sink buffer past that index is unreachable
//     so no zeroing is needed there.
//
//   tty_write_bytes : (u64, u64) -> u64 !{mem} @{}
//     RDI: src ptr
//     RSI: byte count
//     RAX: TTY_OK (0) on success, TTY_SINK_OVERFLOW on overflow.
//     Copies bytes from src into tty_out_buf starting at
//     tty_out_len, advancing the cursor by the number of bytes
//     copied. Overflow leaves tty_out_len at the partial-write
//     cursor — matches KIND_TTY(write)'s partial-write shape.
//
//   tty_write_byte : (u64) -> u64 !{mem} @{}
//     RDI: byte value in low 8 bits (upper bits ignored via mov_b)
//     RAX: TTY_OK (0) on success, TTY_SINK_OVERFLOW at cap
//     M2-002 helper. Render layer calls this per emitted output
//     byte (line-num digits + `^X` escape sequences); using a
//     tight single-byte helper avoids fabricating a stack-local
//     one-byte buffer at every call site. Body-only shell.M4 patch
//     will replace the sink store with a KIND_TTY(write) syscall.
//
// paideia-as compliance
// ---------------------
//   - Module name PascalCase basename (`TtySink`), no directory
//     prefix.
//   - No `test` mnemonic; every zero-check via `cmp reg, 0`.
//   - Every `cmp reg, imm` uses immediate ≤ 0x7FFFFFFF (largest:
//     65536 for TTY_OUT_CAP).
//   - r11 scratch; reloaded before every `.bss` read/write.
//   - Byte reads use `xor rax, rax; mov_b rax, [ptr]` (#1248
//     mitigation).
//   - `tty_reset`, `tty_write_bytes`, `tty_write_byte` are all
//     leaf functions (no `call` inside); no push/pop parity to
//     preserve.
//   - Byte-write to sink uses `mov_b [r10], rax` after computing
//     `r10 = tty_out_buf + cursor` via `lea + add` — avoids the
//     `[base + reg]` byte-scale addressing form that has no
//     precedent in R49 reference implementations (same idiom as
//     doc's `DocRenderer::render_section`).

module TtySink = structure {

  // ============================================================================
  // Return codes
  // ============================================================================
  pub let TTY_OK             : u64 = 0
  pub let TTY_SINK_OVERFLOW  : u64 = 0xFFFFFFF4

  // ============================================================================
  // Sink capacity — 64 KiB. Fits `cmp reg, imm ≤ 0x7FFFFFFF` trivially.
  // M2 widens from M1's 4 KiB so the 64 KiB chunk-buffer streaming
  // path + the render inflation (line-numbering prefix + -A escapes)
  // can be exercised end-to-end from the M4 test harness without
  // exhausting the sink on the first chunk.
  // ============================================================================
  pub let TTY_OUT_CAP : u64 = 65536

  // ============================================================================
  // Singleton storage (bootstrap-scope; M4 migrates to caller-owned)
  // ============================================================================

  // Sink buffer + cursor. shell.M4 replaces this pair with a
  // KIND_TTY(write) syscall wrapper — the syscall accumulates the
  // same "bytes written" statistic but drops the local buffer.
  pub let mut tty_out_buf : [u8; 65536] = uninit @align(8)
  pub let mut tty_out_len : u64         = uninit @align(8)

  // ============================================================================
  // tty_reset()
  //
  // Signature: tty_reset : () -> () !{mem} @{}
  //
  // Zero tty_out_len. The sink is consumed by index up to
  // tty_out_len, so stale bytes past that index are unreachable —
  // no zeroing of the buffer itself is needed.
  //
  // Leaf function; r11 scratch; no push/pop parity to preserve.
  // ============================================================================
  pub let tty_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "cat.M1-003 tty_reset. Zero tty_out_len. xor rax,rax produces the zero constant. Sink buffer is bounded by tty_out_len; stale trailing bytes past that index are unreachable. Leaf function; r11 scratch.",
      block: {
        xor rax, rax;
        lea r11, [rip + tty_out_len];
        mov [r11], rax;
        ret;
      }
    }

  // ============================================================================
  // tty_write_bytes(buf, len) -> rc
  //
  // Signature: tty_write_bytes : (u64, u64) -> u64 !{mem} @{}
  //   RDI: src ptr
  //   RSI: byte count to copy
  //   RAX: TTY_OK on success, TTY_SINK_OVERFLOW if the sink cap
  //        would be exceeded before the full byte count is copied.
  //        On overflow, tty_out_len reflects the partial-write
  //        cursor (matches KIND_TTY(write)'s partial-write shape).
  //
  // Empty writes (len == 0) succeed with zero bytes copied.
  //
  // Register plan (leaf; no external call):
  //   r9  = src walking cursor (rdi + i)
  //   r8  = src end            (rdi + rsi)
  //   rcx = sink write cursor  (byte index; starts at tty_out_len,
  //                             equal to final tty_out_len at exit)
  //   r10 = &tty_out_buf + rcx (recomputed each iteration via
  //                             lea + add — avoids [base + reg]
  //                             byte-scale addressing)
  //   r11 = scratch (paideia-as reserved) — reloaded before every
  //         `.bss` read/write
  //   rax = byte load / return
  // ============================================================================
  pub let tty_write_bytes : (u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "cat.M1-003 tty_write_bytes. Copies rsi bytes from rdi into tty_out_buf starting at tty_out_len. Per-byte copy loop: src cursor r9 walks toward r8 = rdi + rsi; sink cursor rcx walks toward TTY_OUT_CAP = 65536; each iteration recomputes the sink write address r10 = tty_out_buf + rcx via lea + add (avoids [base + reg] byte-scale addressing — same idiom as doc's DocRenderer::render_section). Byte reads use xor rax,rax + mov_b (#1248). All `cmp reg, imm` immediates ≤ 0x7FFFFFFF (65536 largest). Empty write (rsi == 0) succeeds with rc = 0 and no cursor advance. Overflow: loop stops, tty_out_len set to the partial-write cursor, return TTY_SINK_OVERFLOW. Leaf function; no callee-save touched. M2-001..M2-004 raise TTY_OUT_CAP from 4096 to 65536 so the streaming path + render inflation can be exercised end-to-end.",
      block: {
        // ---- Prep loop bounds ------------------------------------------
        mov r9, rdi;                    // r9 = src walking cursor
        mov r8, rdi;
        add r8, rsi;                    // r8 = src end (exclusive)

        // Load current sink cursor.
        lea r11, [rip + tty_out_len];
        mov rcx, [r11];

        // Empty range → success.
        cmp r9, r8;
        jge tty_write_ok_done;

      tty_write_copy_head:
        // Loop invariant:
        //   r9  = src cursor (advances byte-by-byte)
        //   r8  = src end (fixed)
        //   rcx = sink cursor (byte index into tty_out_buf)
        cmp r9, r8;
        jge tty_write_ok_done;

        // Overflow guard: sink cursor at cap → refuse further writes.
        cmp rcx, 65536;                 // TTY_OUT_CAP
        jge tty_write_overflow;

        // Load src byte.
        xor rax, rax;
        mov_b rax, [r9];

        // Compute dst = tty_out_buf + rcx.
        lea r10, [rip + tty_out_buf];
        add r10, rcx;
        mov_b [r10], rax;

        add r9, 1;                      // src cursor++
        add rcx, 1;                     // sink cursor++
        jmp tty_write_copy_head;

      tty_write_ok_done:
        // Update tty_out_len = rcx.
        lea r11, [rip + tty_out_len];
        mov [r11], rcx;

        xor rax, rax;                   // TTY_OK
        ret;

      tty_write_overflow:
        // Persist partial-write cursor before reporting.
        lea r11, [rip + tty_out_len];
        mov [r11], rcx;

        mov rax, 0xFFFFFFF4;            // TTY_SINK_OVERFLOW
        ret;
      }
    }

  // ============================================================================
  // tty_write_byte(byte) -> rc
  //
  // Signature: tty_write_byte : (u64) -> u64 !{mem} @{}
  //   RDI: byte value in low 8 bits (upper bits ignored via mov_b)
  //   RAX: TTY_OK on success, TTY_SINK_OVERFLOW if the sink cap
  //        would be exceeded.
  //
  // M2-002 helper. Render::render_write_bytes calls this per
  // emitted output byte for the -n line-number prefix (each padded
  // digit + the trailing '\t') and for the -A escapes (`^X`, `$`,
  // `M-` prefixes). Using a tight single-byte helper avoids
  // fabricating a stack-local one-byte buffer at every call site.
  // The shell.M4 patch that replaces `tty_write_bytes`'s sink
  // store with a KIND_TTY(write) syscall will apply identically
  // here (a one-byte syscall arg).
  //
  // Leaf function (no `call` inside); no push/pop parity.
  //
  // Register plan (leaf; no external call):
  //   rcx = sink write cursor (byte index; starts at tty_out_len)
  //   r10 = &tty_out_buf + rcx
  //   r11 = scratch (paideia-as reserved) — reloaded before every
  //         `.bss` read/write
  //   rax = byte value copy / return
  // ============================================================================
  pub let tty_write_byte : (u64) -> u64 !{mem} @{} =
    fn (byte: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "cat.M2-002 tty_write_byte. Single-byte write into tty_out_buf at tty_out_len. Load current cursor via lea + mov; overflow guard `cmp rcx, 65536; jge tty_write_byte_overflow`; compute dst = tty_out_buf + rcx via lea + add (avoids [base + reg] byte-scale addressing); mov_b [r10], rdi writes the low 8 bits of the byte argument. All `cmp reg, imm` immediates ≤ 0x7FFFFFFF (65536 largest). Leaf function; r11 scratch; xor rax,rax for the OK path return. Overflow persists the (unchanged) cursor and returns TTY_SINK_OVERFLOW. Symmetric shape to tty_write_bytes so the shell.M4 patch that swaps the sink store for sys_kind_tty_write applies identically here.",
      block: {
        // Load current sink cursor.
        lea r11, [rip + tty_out_len];
        mov rcx, [r11];

        // Overflow guard.
        cmp rcx, 65536;                 // TTY_OUT_CAP
        jge tty_write_byte_overflow;

        // Compute dst = tty_out_buf + rcx and write the low byte of rdi.
        lea r10, [rip + tty_out_buf];
        add r10, rcx;
        mov_b [r10], rdi;

        add rcx, 1;                     // cursor++
        lea r11, [rip + tty_out_len];
        mov [r11], rcx;

        xor rax, rax;                   // TTY_OK
        ret;

      tty_write_byte_overflow:
        mov rax, 0xFFFFFFF4;            // TTY_SINK_OVERFLOW
        ret;
      }
    }
}
