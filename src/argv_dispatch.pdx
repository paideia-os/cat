// src/argv_dispatch.pdx — cat.M1-001 (skeleton) → cat.M1-002 (argv surface)
// CatDispatch module: argv → parsed flags + positional list →
// (stubbed) file read → exit code.
//
// M1-002 replaces the M1-001 single-positional scan with a proper
// flag+positional parser:
//   flags:       -n / -A / --schema  (boolean; arity 0)
//   positionals: file paths, collected in argv-order into pos_ptrs
//
// The dispatcher (cat_dispatch) now runs `cat_reset` → `cat_parse_
// argv` → checks `pos_count` → reads the first positional via the
// stubbed file_read path. The M1-003 wiring will thread the file
// read's byte buffer into TtySink; both later edits are body-only
// against this file.
//
// M1-002 keeps `file_read_stub` inlined in this file so the scaffold
// compiles standalone before src/file_read.pdx exists. M1-003
// removes the local definition and re-hosts the symbol in
// src/file_read.pdx (symbol-swap edit; every call site stays put).
//
// Exit-code discipline (per I4 in design/tooling/plan.md §4.2):
//   0 — read + wrote successfully
//   2 — usage error (parse error, missing file, name too long,
//        positional overflow)
//   3 — system error (sink overflow at M1; file-read I/O at M2+)
//   4 — cap denied / file not found (stubbed until M2)
//
// paideia-as compliance
// ---------------------
//   - Module name PascalCase basename (`CatDispatch`), no directory
//     prefix.
//   - No `test` mnemonic; every zero-check via `cmp reg, 0`.
//   - Every `cmp reg, imm` uses immediate ≤ 0x7FFFFFFF (M1 largest:
//     236 for NAME_MAX_LEN, 8 for POS_MAX, plus per-byte ASCII).
//   - r11 scratch (paideia-as reserved); reloaded before every
//     .bss read/write.
//   - Byte reads use `xor rax, rax; mov_b rax, [ptr]` (#1248
//     mitigation).
//   - SysV push/pop parity preserved in every non-leaf function.
//   - Instruction vocabulary stays inside the R49 reference-
//     implementation subset (add / and / or / xor / shl / shr /
//     mov / mov_b / cmp / lea / call / ret / push / pop / jmp /
//     je / jne / jge / jg / jl / jle). No `sub` on general regs,
//     no `not`, `neg`, `dec`, `inc`.

module CatDispatch = structure {

  // ============================================================================
  // Exit codes (per I4 collapsed vocabulary)
  // ============================================================================
  pub let CAT_EXIT_OK               : u64 = 0
  pub let CAT_EXIT_USAGE_ERROR      : u64 = 2
  pub let CAT_EXIT_SYSTEM_ERROR     : u64 = 3
  pub let CAT_EXIT_CAP_DENIED       : u64 = 4

  // ============================================================================
  // Parser return codes (internal to cat_parse_argv). Collapsed to
  // CAT_EXIT_USAGE_ERROR by cat_dispatch for the process exit.
  // ============================================================================
  pub let PARSE_OK                          : u64 = 0
  pub let PARSE_ERR_UNKNOWN_LONG_FLAG       : u64 = 1
  pub let PARSE_ERR_UNKNOWN_OR_CLUSTERED_SHORT : u64 = 2
  pub let PARSE_ERR_POS_OVERFLOW            : u64 = 3
  pub let PARSE_ERR_LONG_MISSING_NAME       : u64 = 4
  pub let PARSE_ERR_NAME_TOO_LONG           : u64 = 5

  // ============================================================================
  // Flag bit mask constants
  // ============================================================================
  pub let FLAG_N       : u64 = 0x1   // -n      (line numbering — M2)
  pub let FLAG_A       : u64 = 0x2   // -A      (non-printable render — M2)
  pub let FLAG_SCHEMA  : u64 = 0x4   // --schema (schema records — M3)

  // ============================================================================
  // Argv-parse limits
  // ============================================================================

  // Max length of a positional file name (bytes, excluding NUL).
  // Shared upper bound with the doc reader; the true KIND_PDXFS_FILE
  // path bound at R42 substrate is 4 KiB, but M1 keeps 236 across
  // the R49/R50 tools so the hand-audit surface stays small.
  pub let NAME_MAX_LEN : u64 = 236

  // Max number of positional file arguments per invocation. 8 is the
  // M1 ceiling; M2-003's streaming-read work removes the cap.
  pub let POS_MAX : u64 = 8

  // ============================================================================
  // Singleton .bss (bootstrap-scope; M4 migrates to caller-owned)
  // ============================================================================

  // Parsed flag bit mask (see FLAG_* above). 0 after cat_reset.
  pub let mut flag_mask : u64 = uninit @align(8)

  // Positional file pointers (interior into caller-owned argv memory).
  // Only entries [0 .. pos_count) are meaningful.
  pub let mut pos_ptrs : [u64; 8] = uninit @align(8)

  // Number of positional entries stored in pos_ptrs. 0 after
  // cat_reset; incremented by cat_parse_argv on each positional.
  pub let mut pos_count : u64 = uninit @align(8)

  // Offending argv index on parse error. 0 after cat_reset; set by
  // cat_parse_argv to the index of the argv entry that failed the
  // grammar check. Consumed by the M4 diagnostic renderer.
  pub let mut parse_error_arg_index : u64 = uninit @align(8)

  // ============================================================================
  // cat_reset()
  //
  // Signature: cat_reset : () -> () !{mem} @{}
  //
  // Zero flag_mask, pos_count, parse_error_arg_index. pos_ptrs
  // entries past pos_count are unreachable so no zeroing is needed
  // there.
  //
  // Leaf function; r11 scratch; no push/pop parity to preserve.
  // ============================================================================
  pub let cat_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "cat.M1-002 cat_reset. Zero flag_mask, pos_count, parse_error_arg_index so a subsequent cat_parse_argv starts from a known baseline. Mirror of doc's render_reset shape. Leaf function; r11 scratch used only for the .bss lea; no callee-save touched.",
      block: {
        xor rax, rax;
        lea r11, [rip + flag_mask];              mov [r11], rax;
        lea r11, [rip + pos_count];              mov [r11], rax;
        lea r11, [rip + parse_error_arg_index];  mov [r11], rax;
        ret
      }
    }

  // ============================================================================
  // cat_parse_argv(argv, argc) -> rc
  //
  // Signature: cat_parse_argv : (u64, u64) -> u64 !{mem} @{}
  //   RDI: argv (u64* — array of NUL-terminated arg pointers)
  //   RSI: argc (count of entries in argv)
  //   RAX: PARSE_OK (0) on success, else one of the PARSE_ERR_*
  //        codes above. On error, parse_error_arg_index is also
  //        set to the offending argv index.
  //
  // Grammar (see design/architecture.md §2):
  //   argv     = argv[0] (skipped) flag* positional+
  //   flag     = "-n" | "-A" | "--schema"    (boolean, arity 0)
  //   positional = <NUL-terminated bytes; length ≤ NAME_MAX_LEN>
  //
  // Short flags MUST be exactly one letter after '-'. Anything
  // longer (e.g. "-nA") is rejected as
  // PARSE_ERR_UNKNOWN_OR_CLUSTERED_SHORT per the D3 one-per-hyphen
  // contract.
  //
  // Long flags MUST match the whitelist. "--schema" is the only
  // long flag accepted at M1. Bare "--" or "--=foo" is
  // PARSE_ERR_LONG_MISSING_NAME. Any other long flag is
  // PARSE_ERR_UNKNOWN_LONG_FLAG.
  //
  // Positional length is checked byte-by-byte with a NAME_MAX_LEN
  // bound guard so a pathological argv[i] without any NUL cannot
  // walk off the end forever.
  //
  // Register plan (leaf; no callee-save touched):
  //   r8  = i          (arg loop counter)
  //   r9  = argv       (base copy of rdi)
  //   r10 = argc       (copy of rsi)
  //   r11 = scratch    (paideia-as reserved; every .bss lea)
  //   rax = byte load / return
  //   rcx = walk cursor / measured-len accumulator
  //   rdx = current argv[i] pointer
  // ============================================================================
  pub let cat_parse_argv : (u64, u64) -> u64 !{mem} @{} =
    fn (argv: u64) (argc: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "cat.M1-002 cat_parse_argv. Walks argv[1..argc-1]; classifies each arg as long-flag / short-flag / positional per design/architecture.md §2 grammar. Boolean-only flags (arity 0 — a shell that wrote 'cat -n foo.txt' means cat reads foo.txt, not that -n's value is foo.txt; libpdx-argv M1-002's greedy value-lookahead would misparse this, which is why cat rolls its own scan at M1). Long-flag whitelist at M1: --schema only (byte-exact compare against 's','c','h','e','m','a' + NUL, mirror of libpdx-argv's --pdx-schema inline compare). Short-flag whitelist at M1: -n and -A (single-letter after '-' + NUL). Positional accumulator uses pos_ptrs[pos_count] and enforces POS_MAX = 8 (M2-003 removes the cap). Every positional walked to NUL with NAME_MAX_LEN = 236 bound to protect against argv without terminator. All immediates in `cmp reg, imm` are ≤ 0x7FFFFFFF (max 236). Every byte load preceded by xor rax,rax (#1248). Leaf function — no callee-save touched, no push/pop.",
      block: {
        // ---- prologue --------------------------------------------------
        mov r9, rdi;                    // r9  = argv base
        mov r10, rsi;                   // r10 = argc
        mov r8, 1;                      // r8  = i (skip argv[0])

      cat_parse_loop_head:
        cmp r8, r10;
        jge cat_parse_done_ok;

        mov rdx, [r9 + r8*8];           // rdx = argv[i]

        // byte0 = rdx[0]. '-' == 0x2D.
        xor rax, rax;
        mov_b rax, [rdx];
        cmp rax, 0x2D;
        je cat_parse_maybe_flag;
        jmp cat_parse_positional;

      cat_parse_maybe_flag:
        // byte1 = rdx[1]. '-' → long, NUL → bare '-' (positional
        // per POSIX convention for stdin), else → short.
        xor rax, rax;
        mov_b rax, [rdx + 1];
        cmp rax, 0x2D;
        je cat_parse_long_flag;
        cmp rax, 0;
        je cat_parse_positional;        // bare "-" is a positional
        jmp cat_parse_short_flag;

        // ============================================================
        //   Long-flag branch: only --schema accepted at M1
        // ============================================================
      cat_parse_long_flag:
        // byte2 = rdx[2]. NUL → bare "--"; '=' → "--=..." → both
        // are PARSE_ERR_LONG_MISSING_NAME.
        xor rax, rax;
        mov_b rax, [rdx + 2];
        cmp rax, 0;
        je cat_parse_long_missing;
        cmp rax, 0x3D;                  // '=' == 0x3D
        je cat_parse_long_missing;

        // Byte-exact "--schema" match. Bytes at rdx+2..rdx+7 must be
        // 's','c','h','e','m','a', and rdx+8 must be NUL. Any
        // mismatch → PARSE_ERR_UNKNOWN_LONG_FLAG.
        xor rax, rax; mov_b rax, [rdx + 2]; cmp rax, 0x73; jne cat_parse_unknown_long;   // 's'
        xor rax, rax; mov_b rax, [rdx + 3]; cmp rax, 0x63; jne cat_parse_unknown_long;   // 'c'
        xor rax, rax; mov_b rax, [rdx + 4]; cmp rax, 0x68; jne cat_parse_unknown_long;   // 'h'
        xor rax, rax; mov_b rax, [rdx + 5]; cmp rax, 0x65; jne cat_parse_unknown_long;   // 'e'
        xor rax, rax; mov_b rax, [rdx + 6]; cmp rax, 0x6D; jne cat_parse_unknown_long;   // 'm'
        xor rax, rax; mov_b rax, [rdx + 7]; cmp rax, 0x61; jne cat_parse_unknown_long;   // 'a'
        xor rax, rax; mov_b rax, [rdx + 8]; cmp rax, 0;    jne cat_parse_unknown_long;   // NUL

        // Match. Set FLAG_SCHEMA bit.
        lea r11, [rip + flag_mask];
        mov rax, [r11];
        or  rax, 0x4;                   // FLAG_SCHEMA
        mov [r11], rax;
        jmp cat_parse_advance;

      cat_parse_unknown_long:
        mov rax, 1;                     // PARSE_ERR_UNKNOWN_LONG_FLAG
        jmp cat_parse_fail;

      cat_parse_long_missing:
        mov rax, 4;                     // PARSE_ERR_LONG_MISSING_NAME
        jmp cat_parse_fail;

        // ============================================================
        //   Short-flag branch: -n / -A single-letter only
        // ============================================================
      cat_parse_short_flag:
        // rdx[1] is the letter. rdx[2] must be NUL — anything else
        // is a clustered short like "-nA" and is rejected.
        xor rax, rax;
        mov_b rax, [rdx + 2];
        cmp rax, 0;
        jne cat_parse_unknown_short;

        // rdx[1] letter dispatch: 'n' = 0x6E, 'A' = 0x41.
        xor rax, rax;
        mov_b rax, [rdx + 1];
        cmp rax, 0x6E;
        je cat_parse_short_n;
        cmp rax, 0x41;
        je cat_parse_short_A;
        jmp cat_parse_unknown_short;

      cat_parse_short_n:
        lea r11, [rip + flag_mask];
        mov rax, [r11];
        or  rax, 0x1;                   // FLAG_N
        mov [r11], rax;
        jmp cat_parse_advance;

      cat_parse_short_A:
        lea r11, [rip + flag_mask];
        mov rax, [r11];
        or  rax, 0x2;                   // FLAG_A
        mov [r11], rax;
        jmp cat_parse_advance;

      cat_parse_unknown_short:
        mov rax, 2;                     // PARSE_ERR_UNKNOWN_OR_CLUSTERED_SHORT
        jmp cat_parse_fail;

        // ============================================================
        //   Positional branch
        // ============================================================
      cat_parse_positional:
        // Length check: walk rdx to NUL, bounded at NAME_MAX_LEN.
        mov rcx, rdx;
        xor rax, rax;                   // reuse rax as len accumulator? No — need for byte load.
        // Use r11 as the len accumulator here (paideia-as scratch;
        // no .bss access happens in this loop body until the store).
        xor r11, r11;

      cat_parse_pos_measure_head:
        cmp r11, 236;                   // NAME_MAX_LEN
        jg cat_parse_name_too_long;

        xor rax, rax;
        mov_b rax, [rcx];
        cmp rax, 0;
        je cat_parse_pos_measure_done;
        add rcx, 1;
        add r11, 1;
        jmp cat_parse_pos_measure_head;

      cat_parse_pos_measure_done:
        // Reject empty positional (argv[i] == "\0"). A bare "-"
        // routes here from the long-flag branch and IS a valid
        // positional (M2-004 uses it for stdin), so we do NOT
        // reject len == 1 with rdx[0] == '-'. But len == 0 (empty
        // string) is never valid.
        cmp r11, 0;
        je cat_parse_empty_pos;

        // pos_count bound check.
        lea r11, [rip + pos_count];
        mov rax, [r11];
        cmp rax, 8;                     // POS_MAX
        jge cat_parse_pos_overflow;

        // Store pos_ptrs[pos_count] = rdx and bump pos_count.
        lea r11, [rip + pos_ptrs];
        mov [r11 + rax*8], rdx;

        add rax, 1;
        lea r11, [rip + pos_count];
        mov [r11], rax;
        jmp cat_parse_advance;

      cat_parse_empty_pos:
        // An empty argv entry is a usage error — collapse to the
        // same code as pos overflow's caller-visible exit 2. Use
        // the same PARSE_ERR_POS_OVERFLOW code so the diagnostic
        // renderer prints one uniform "positional slot" message.
        mov rax, 3;                     // PARSE_ERR_POS_OVERFLOW
        jmp cat_parse_fail;

      cat_parse_pos_overflow:
        mov rax, 3;                     // PARSE_ERR_POS_OVERFLOW
        jmp cat_parse_fail;

      cat_parse_name_too_long:
        mov rax, 5;                     // PARSE_ERR_NAME_TOO_LONG
        jmp cat_parse_fail;

        // ============================================================
        //   Loop advance / termination
        // ============================================================
      cat_parse_advance:
        add r8, 1;
        jmp cat_parse_loop_head;

      cat_parse_fail:
        // rax = error code. Record offending arg index + return.
        lea r11, [rip + parse_error_arg_index];
        mov [r11], r8;
        ret

      cat_parse_done_ok:
        xor rax, rax;                   // PARSE_OK
        ret
      }
    }

  // ============================================================================
  // cat_dispatch(argv, argc) -> exit_code
  //
  // Signature: cat_dispatch : (u64, u64) -> u64 !{mem} @{}
  //   RDI: argv (u64* — array of NUL-terminated arg pointers)
  //   RSI: argc (count of entries in argv)
  //   RAX: exit code (0 / 2 / 3 / 4 per I4)
  //
  // M1-002 flow:
  //   1. cat_reset() — zero parsed state.
  //   2. cat_parse_argv(argv, argc) — parse flags + positional list.
  //      Non-zero return → CAT_EXIT_USAGE_ERROR (2).
  //   3. If pos_count == 0 → CAT_EXIT_USAGE_ERROR (M2-004 replaces
  //      this arm with stdin passthrough).
  //   4. Call file_read_stub. rax == 0 → CAT_EXIT_CAP_DENIED (4).
  //   5. M1-003 will insert tty_write_bytes(rax, file_src_len)
  //      between step 4's non-zero arm and the epilogue; the M1-002
  //      body returns CAT_EXIT_OK from the fall-through arm which
  //      is unreachable at runtime under the M1 stub.
  //
  // Register plan (non-leaf; three nested calls):
  //   r12 = argv (callee-save copy of rdi)
  //   r13 = argc (callee-save copy of rsi)
  //   Alignment pad: three pushes → rsp%16 == 0 at each nested
  //   call. r14 pushed as pad-only carry to preserve SysV parity.
  //
  // rsp arithmetic:
  //   caller-of-cat_dispatch: rsp%16 == 0 immediately before call
  //   after CALL:             rsp%16 == 8 (return address pushed)
  //   after push r12:         rsp%16 == 0
  //   after push r13:         rsp%16 == 8
  //   after push r14:         rsp%16 == 0  ← nested call sites ok
  //   epilogue mirrors.
  // ============================================================================
  pub let cat_dispatch : (u64, u64) -> u64 !{mem} @{} =
    fn (argv: u64) (argc: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "cat.M1-002 cat_dispatch. Sequences cat_reset → cat_parse_argv → pos_count check → file_read_stub. Parse failure collapses to CAT_EXIT_USAGE_ERROR (2). Zero positionals collapses to CAT_EXIT_USAGE_ERROR (M2-004 replaces with stdin passthrough). file_read_stub == 0 collapses to CAT_EXIT_CAP_DENIED (4). Non-leaf: 3-push prologue (r12/r13/r14) preserves argc/argv across cat_parse_argv and keeps rsp%16 == 0 at every nested call site. Mirror-order pop in epilogue. All immediates ≤ 0x7FFFFFFF (max: 4 for CAT_EXIT_CAP_DENIED). r11 scratch for the pos_count .bss read.",
      block: {
        // ---- prologue: save + align ------------------------------------
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                   // r12 = argv
        mov r13, rsi;                   // r13 = argc

        // ---- Step 1: reset parser state --------------------------------
        call cat_reset;

        // ---- Step 2: parse argv ----------------------------------------
        mov rdi, r12;
        mov rsi, r13;
        call cat_parse_argv;
        cmp rax, 0;
        jne cat_dispatch_usage_error;

        // ---- Step 3: require ≥ 1 positional at M1 (stdin at M2-004) --
        lea r11, [rip + pos_count];
        mov rax, [r11];
        cmp rax, 0;
        je cat_dispatch_usage_error;

        // ---- Step 4: stubbed file read ---------------------------------
        // M1-002 keeps file_read_stub inline (below); M1-003 hosts
        // the symbol in src/file_read.pdx. Contract: rax = src ptr
        // (0 = not found).
        call file_read_stub;
        cmp rax, 0;
        je cat_dispatch_cap_denied;

        // ---- Step 5 wiring lands at M1-003 -----------------------------
        // At M1-002 the fall-through arm is unreachable (stub
        // always returns 0). At M1-003 the tty_write_bytes call
        // goes here.
        xor rax, rax;                   // CAT_EXIT_OK (unreachable at M1)
        jmp cat_dispatch_epilogue;

      cat_dispatch_usage_error:
        mov rax, 2;                     // CAT_EXIT_USAGE_ERROR
        jmp cat_dispatch_epilogue;

      cat_dispatch_cap_denied:
        mov rax, 4;                     // CAT_EXIT_CAP_DENIED

      cat_dispatch_epilogue:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ============================================================================
  // file_read_stub() -> src_ptr_or_zero
  //
  // Signature: file_read_stub : () -> u64 !{mem} @{}
  //   RAX: 0 (M1 stub always returns "not found"). M1-003 removes
  //        this inline definition and re-hosts the symbol in
  //        src/file_read.pdx (symbol-swap edit; the call site in
  //        cat_dispatch is unchanged).
  //
  // Leaf function; no push/pop parity.
  // ============================================================================
  pub let file_read_stub : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "cat.M1-002 file_read_stub (inline; still hosted here at M1-002). Returns 0 in rax unconditionally — the correct behaviour until R42 substrate (KIND_PDXFS_FILE) lands per r49-r50-plan.md §2.4. M1-003 removes this definition and re-hosts the same symbol in src/file_read.pdx; the call site in cat_dispatch does not change. Leaf function; no push/pop parity.",
      block: {
        xor rax, rax;
        ret
      }
    }
}
